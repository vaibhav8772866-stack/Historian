# Database Configuration (Supports SQLite and PostgreSQL)
DATABASE_URL=sqlite:///./historian.db

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","*"]

# LLM / AI Assistant (HARVEY) Configuration
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Enterprise SMTP Email Configuration (Optional - Falls back to secure dev dispatcher if unconfigured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@historian.ai
EMAILS_FROM_NAME=Historian AI

# Storage & Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
